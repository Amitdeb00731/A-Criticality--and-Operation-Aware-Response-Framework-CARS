<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="cars-firstpacket" name="First-packet residual">
    <mxGraphModel dx="1400" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- leaked-window band (behind) -->
        <mxCell id="band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEBEC;strokeColor=none;opacity=55;" vertex="1" parent="1">
          <mxGeometry x="720" y="234" width="510" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="bandlbl" value="leaked window — first packet already delivered" style="text;html=1;align=center;fontColor=#B21F26;fontStyle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="430" height="24" as="geometry"/>
        </mxCell>

        <!-- lifelines -->
        <mxCell id="ll_host" style="endArrow=none;dashed=1;dashPattern=4 6;strokeColor=#B7C4CE;strokeWidth=2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="90" as="sourcePoint"/><mxPoint x="210" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_fab" style="endArrow=none;dashed=1;dashPattern=4 6;strokeColor=#B7C4CE;strokeWidth=2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="90" as="sourcePoint"/><mxPoint x="720" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_plc" style="endArrow=none;dashed=1;dashPattern=4 6;strokeColor=#B7C4CE;strokeWidth=2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="90" as="sourcePoint"/><mxPoint x="1230" y="800" as="targetPoint"/></mxGeometry></mxCell>

        <!-- headers -->
        <mxCell id="h_host" value="Compromised allowlisted host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D7D7;strokeColor=#B21F26;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="h_fab" value="CARS fabric · Table 1 POLICY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EEF2;strokeColor=#0B6E7A;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="h_plc" value="Target PLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7CC;strokeColor=#E0952F;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="300" height="50" as="geometry"/></mxCell>

        <!-- 1 STOP message -->
        <mxCell id="m_stop" value="S7 STOP (0x29) on the permitted conduit" style="endArrow=classic;html=1;strokeColor=#B21F26;strokeWidth=2.5;fontSize=13;fontColor=#1B2A3A;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="170" as="sourcePoint"/><mxPoint x="720" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 2 delivered message -->
        <mxCell id="m_deliv" value="permitted (established / allowlisted) → delivered" style="endArrow=classic;html=1;strokeColor=#1B2A3A;strokeWidth=2.5;fontSize=13;fontColor=#1B2A3A;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="250" as="sourcePoint"/><mxPoint x="1230" y="250" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 3 PLC state box -->
        <mxCell id="plcstate" value="state change taken on receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7CC;strokeColor=#E0952F;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="290" width="300" height="52" as="geometry"/></mxCell>

        <!-- out-of-band connector from fabric to mirror -->
        <mxCell id="c_oob1" style="endArrow=none;dashed=1;dashPattern=7 6;strokeColor=#6E7B99;strokeWidth=2;html=1;curved=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="250" as="sourcePoint"/><mxPoint x="470" y="372" as="targetPoint"/></mxGeometry></mxCell>
        <!-- OOB stack -->
        <mxCell id="oob1" value="out-of-band mirror copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF5;strokeColor=#6E7B99;fontColor=#6E7B99;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="372" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="oob2" value="Snort DPI: alert on 0x29" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF5;strokeColor=#6E7B99;fontColor=#6E7B99;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="oob3" value="controller classify() → FORBIDDEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF5;strokeColor=#6E7B99;fontColor=#6E7B99;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="488" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="oob4" value="OFPT_FLOW_MOD (isolate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF5;strokeColor=#6E7B99;fontColor=#6E7B99;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="546" width="300" height="44" as="geometry"/></mxCell>
        <!-- connector OOB to green box -->
        <mxCell id="c_oob2" style="endArrow=none;dashed=1;dashPattern=7 6;strokeColor=#6E7B99;strokeWidth=2;html=1;curved=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="590" as="sourcePoint"/><mxPoint x="720" y="628" as="targetPoint"/></mxGeometry></mxCell>

        <!-- green reactive drop box -->
        <mxCell id="drop" value="&lt;b&gt;reactive drop installed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6E7B99&quot;&gt;Table 1, priority 110, cookie 0x00ca&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF7F3;strokeColor=#4E9A51;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="628" width="380" height="58" as="geometry"/></mxCell>

        <!-- annotation arrow below the green box -->
        <mxCell id="m_note" value="drop now active — but the STOP already landed" style="endArrow=classic;html=1;strokeColor=#4E9A51;strokeWidth=2;fontSize=12;fontColor=#3E4A57;fontStyle=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912" y="716" as="sourcePoint"/><mxPoint x="1078" y="716" as="targetPoint"/></mxGeometry></mxCell>

        <!-- footnote -->
        <mxCell id="foot" value="The proactive default-deny stops an unregistered source before any payload lands; this residual is only reachable from a compromised allowlisted conduit, and is the analytical counterpart of the measured first-packet leak of Section 4.6. Process inertia buffers an analog write; a discrete command does not wait." style="text;html=1;align=center;fontColor=#6E7B99;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="808" width="1100" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
