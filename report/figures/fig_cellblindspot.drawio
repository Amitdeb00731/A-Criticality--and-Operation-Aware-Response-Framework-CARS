        <mxCell id="lg1t" value="Crosses the gateway → mirrored to Snort → operation-aware (DPI) response." style="text;html=1;align=left;fontSize=13;fontColor=#1B2A3A;" vertex="1" parent="1"><mxGeometry x="160" y="815" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2" style="endArrow=classic;strokeColor=#B21F26;strokeWidth=4;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="862" as="sourcePoint"/><mxPoint x="150" y="862" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg2t" value="Stays within a cell → never reaches the mirror → no operation-aware response." style="text;html=1;align=left;fontSize=13;fontColor=#1B2A3A;" vertex="1" parent="1"><mxGeometry x="160" y="849" width="720" height="24" as="geometry"/></mxCell>
        <mxCell id="note" value="The proactive layer (GUARD identity-binding and default-deny) runs on every switch, so an unregistered intra-cell source is still refused; the blind spot is the operation-aware tier for a compromised, already-allowlisted conduit. Per-cell sensing is the mitigation (future work)." style="text;html=1;align=left;fontColor=#6B7E8F;fontStyle=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="888" width="1200" height="40" as="geometry"/></mxCell>
