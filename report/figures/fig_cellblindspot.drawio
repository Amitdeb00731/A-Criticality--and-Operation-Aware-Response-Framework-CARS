        <mxCell id="blind" value="not mirrored → DPI blind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEBEC;strokeColor=none;fontColor=#B21F26;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="344" width="240" height="34" as="geometry"/></mxCell>

