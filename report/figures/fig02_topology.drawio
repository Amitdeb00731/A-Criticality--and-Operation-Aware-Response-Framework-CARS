<mxfile host="app.diagrams.net" type="device">
  <diagram name="Fig2-Topology" id="fig02">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- zones -->
        <mxCell id="z1" value="Cell-1  (Dell 1, ovs1 = dpid 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f7ff;strokeColor=#9fb8d6;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#3b5b86;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="290" height="260" as="geometry" /></mxCell>
        <mxCell id="zg" value="Gateway and seams  (Dell 1, ovsgw = dpid 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3faf1;strokeColor=#a7c9a0;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#4a6b45;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="470" height="380" as="geometry" /></mxCell>
        <mxCell id="z2" value="Cell-2  (Dell 3, ovs2 = dpid 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f7ff;strokeColor=#9fb8d6;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#3b5b86;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="260" height="260" as="geometry" /></mxCell>

        <!-- controller -->
        <mxCell id="ctrl" value="CARS controller  (Dell 2)&#10;os-ken, OpenFlow 1.3, API :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="250" height="50" as="geometry" /></mxCell>

        <!-- switches -->
        <mxCell id="s1" value="ovs1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="110" height="36" as="geometry" /></mxCell>
        <mxCell id="sg" value="ovsgw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="s2" value="ovs2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="945" y="150" width="110" height="36" as="geometry" /></mxCell>

        <!-- OpenFlow control links -->
        <mxCell id="of1" style="endArrow=none;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="ctrl" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="of2" style="endArrow=none;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="ctrl" target="sg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="of3" style="endArrow=none;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="ctrl" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- inter-switch links -->
        <mxCell id="l1" value="patch" style="endArrow=none;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="s1" target="sg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" value="transit + NAT (.3.x)" style="endArrow=none;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="sg" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Cell-1 hosts -->
        <mxCell id="plc1" value="PLC1&#10;192.168.2.10&#10;CRITICAL &amp;#183; p1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="120" height="56" as="geometry" /></mxCell>
        <mxCell id="hmi1" value="HMI1&#10;192.168.2.9&#10;HIGH &amp;#183; p2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="185" y="240" width="120" height="56" as="geometry" /></mxCell>
        <mxCell id="c1a" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="s1" target="plc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c1b" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="s1" target="hmi1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Gateway hosts -->
        <mxCell id="scada" value="SCADA .2.31 &amp;#183; p10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="220" width="130" height="30" as="geometry" /></mxCell>
        <mxCell id="hist" value="Historian .2.30 &amp;#183; p3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="258" width="130" height="30" as="geometry" /></mxCell>
        <mxCell id="rem" value="Remediation .2.45 &amp;#183; p14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="296" width="150" height="30" as="geometry" /></mxCell>
        <mxCell id="ews" value="EWS + Factory IO .2.55 &amp;#183; p12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="220" width="185" height="30" as="geometry" /></mxCell>
        <mxCell id="mb" value="Modbus PLC .2.20 &amp;#183; LOW &amp;#183; p7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="258" width="185" height="30" as="geometry" /></mxCell>
        <mxCell id="snort" value="Snort DPI &amp;#183; p4 (mirror)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="296" width="150" height="30" as="geometry" /></mxCell>
        <mxCell id="hpot" value="Honeypot .3.99 &amp;#183; p6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="375" y="334" width="150" height="30" as="geometry" /></mxCell>
        <mxCell id="kali" value="Kali .2.77 &amp;#183; p13&#10;unregistered (attacker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="334" width="185" height="44" as="geometry" /></mxCell>
        <mxCell id="more" value="also on ovsgw: IT vantage (p2), attacker .2.66 (p11) / .2.67 (p5), Cell-2 seam (p8), uplink (p9). Full 14-port map in Appendix." style="text;html=1;align=left;whiteSpace=wrap;fontSize=9;fontColor=#4a6b45;" vertex="1" parent="1"><mxGeometry x="375" y="392" width="360" height="40" as="geometry" /></mxCell>

        <mxCell id="ga" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="sg" target="scada"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gb" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="sg" target="ews"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="gc" style="endArrow=none;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="sg" target="kali"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Cell-2 hosts -->
        <mxCell id="plc2" value="PLC2&#10;192.168.3.10 (int .2.10)&#10;HIGH &amp;#183; p1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="130" height="56" as="geometry" /></mxCell>
        <mxCell id="hmi2" value="HMI2&#10;192.168.3.9 (int .2.9)&#10;MEDIUM &amp;#183; p2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="304" width="130" height="52" as="geometry" /></mxCell>
        <mxCell id="natgw" value="NAT gw .2.1 (p5)&#10;DNAT .3.10 &amp;#8594; .2.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1020" y="240" width="100" height="52" as="geometry" /></mxCell>
        <mxCell id="c2a" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="s2" target="plc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2b" style="endArrow=none;html=1;strokeColor=#666666;" edge="1" parent="1" source="s2" target="hmi2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cap" value="Figure 2: The SDN-ICS testbed topology. Three OpenFlow switches under one controller: Cell-1 and the gateway on Dell 1, Cell-2 on Dell 3 reached by a NAT clone. The gateway carries the supervisory seams, the engineering and Factory IO host, the Snort mirror, the honeypot, and the attacker vantage. Addresses, tiers, and ofports are from the running fabric (full port and binding map in Appendix)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="1100" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
