<mxfile host="app.diagrams.net" type="device">
  <diagram name="Fig8-HIL" id="fig08">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fio" value="&lt;b&gt;Factory IO &amp;#8212; Level Control scene&lt;/b&gt;&#10;(Windows Dell, EWS 192.168.2.55)&#10;tank, fill valve, discharge valve,&#10;Start / Reset / Stop buttons, lamps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="fab" value="CARS&#10;SDN fabric&#10;(all S7 traffic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="175" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="plc" value="&lt;b&gt;PLC1 &amp;#8212; Siemens S7-1212C&lt;/b&gt; (192.168.2.10)&#10;OB30 cyclic control:&#10;Sim.Level = LevelIn &amp;#215; 20  (DB7, 0&amp;#8211;100)&#10;Fill = 100 if Level&amp;lt;30, 0 if Level&amp;gt;70&#10;Discharge = 40 while Running&#10;Running latched from the buttons" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- sensor + buttons path: FIO -> fabric -> PLC (top) -->
        <mxCell id="t1" value="sensor  LevelIn %ID100 (0&amp;#8211;5)&#10;buttons %I10.0&amp;#8211;10.2" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=9;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="fio" target="fab"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t2" style="endArrow=classic;html=1;strokeColor=#333333;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="fab" target="plc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- actuators + lamps path: PLC -> fabric -> FIO (bottom) -->
        <mxCell id="b1" value="actuators  FillValve %QD100,&#10;DischargeValve %QD104;  lamps %Q0.0&amp;#8211;0.2" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=9;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="plc" target="fab"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="endArrow=classic;html=1;strokeColor=#666666;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="fab" target="fio"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cap" value="Figure 8: The hardware-in-the-loop. Factory IO supplies the level and button inputs and renders the valve and lamp outputs; PLC1 runs the control in OB30. Every exchange crosses the CARS fabric, so the physical loop is governed by the defence. DB7.Level is the process value CARS protects." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="750" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
