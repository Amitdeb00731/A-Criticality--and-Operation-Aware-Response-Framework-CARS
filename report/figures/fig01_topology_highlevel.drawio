<mxfile host="app.diagrams.net" type="device">
  <diagram name="Fig1-HighLevelTopology" id="fig01">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Control plane: CARS controller -->
        <mxCell id="ctrl" value="CARS controller (Dell #2)&#10;os-ken / OpenFlow 1.3&#10;criticality- and operation-aware brain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="30" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Enforcement point: SDN fabric -->
        <mxCell id="fabric" value="SDN fabric (Dell #1)&#10;Open vSwitch + Snort DPI&#10;GUARD | stateful POLICY | SWITCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="170" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- OpenFlow control link -->
        <mxCell id="e_ctrl" value="OpenFlow / control API" style="endArrow=classic;startArrow=classic;html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;" edge="1" parent="1" source="ctrl" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- PLC1 (Cell-1) -->
        <mxCell id="plc1" value="PLC1 (Cell-1)&#10;Siemens S7-1212C&#10;protected asset: CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Factory IO process on Windows Dell (EWS) -->
        <mxCell id="fio" value="Windows Dell (EWS .2.55)&#10;TIA Portal + Factory IO&#10;live tank process (hardware-in-the-loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- HMI operator -->
        <mxCell id="hmi" value="Operator HMI (Cell-1)&#10;.2.9  HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Cell-2 (secondary) -->
        <mxCell id="cell2" value="Cell-2 (Dell #3)&#10;PLC2 + HMI2 (via NAT)&#10;secondary process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="330" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Attacker -->
        <mxCell id="atk" value="Attacker (Kali .2.77)&#10;unregistered, OT-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Data-plane links to the fabric -->
        <mxCell id="e_plc1" value="S7 (OT)" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=9;" edge="1" parent="1" source="plc1" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fio" value="S7 HIL loop" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#666666;fontSize=9;" edge="1" parent="1" source="fio" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_hmi" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="hmi" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cell2" value="transit + NAT" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#999999;dashed=1;fontSize=9;" edge="1" parent="1" source="cell2" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_atk" value="attack traffic" style="endArrow=classic;html=1;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="atk" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- The physical HIL coupling note between PLC1 and Factory IO -->
        <mxCell id="e_loop" value="drives / senses the tank" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#d79b00;dashed=1;fontSize=9;" edge="1" parent="1" source="plc1" target="fio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="title" value="Figure 1: High-level CARS testbed. The SDN fabric is the single enforcement point through which all traffic to the protected PLC passes; the controller governs it; the Factory IO process closes a hardware-in-the-loop with PLC1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="770" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
