[
  {
    "id": "cfg_s7_plc2",
    "type": "s7 endpoint",
    "transport": "iso-on-tcp",
    "address": "192.168.3.10",
    "port": "102",
    "rack": "0",
    "slot": "1",
    "localtsaphi": "01",
    "localtsaplo": "00",
    "remotetsaphi": "01",
    "remotetsaplo": "02",
    "connmode": "rack-slot",
    "adapter": "",
    "busaddr": "2",
    "cycletime": "2000",
    "timeout": "2000",
    "name": "PLC2 S7 (.3.10)",
    "vartable": [
      { "addr": "DB7,REAL0", "name": "level" },
      { "addr": "Q0.3", "name": "pump" }
    ]
  },
  {
    "id": "s7_in_plc2",
    "type": "s7 in",
    "endpoint": "cfg_s7_plc2",
    "mode": "all",
    "variable": "",
    "diff": false,
    "name": "S7 read PLC2 (Tank2)",
    "x": 200,
    "y": 580,
    "wires": [ [ "fn_c2_pub", "fn_c2_ui" ] ]
  },
  {
    "id": "fn_c2_pub",
    "type": "function",
    "name": "cell2 -> MQTT",
    "func": "var p = msg.payload || {};\nvar out = [];\nif (p.level !== undefined) out.push({ topic: 'cars/cell2/plc2/level', payload: Number(p.level) });\nif (p.pump  !== undefined) out.push({ topic: 'cars/cell2/plc2/pump',  payload: p.pump ? 1 : 0 });\nreturn [ out ];",
    "outputs": 1,
    "noerr": 0,
    "x": 460,
    "y": 560,
    "wires": [ [ "mqtt_out_c2" ] ]
  },
  {
    "id": "mqtt_out_c2",
    "type": "mqtt out",
    "name": "publish cars/cell2",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "cfg_mqtt",
    "x": 720,
    "y": 560,
    "wires": []
  },
  {
    "id": "fn_c2_ui",
    "type": "function",
    "name": "level/pump -> ui",
    "func": "var p = msg.payload || {};\nreturn [ { payload: Number(p.level) }, { payload: p.pump ? 'ON' : 'OFF' } ];",
    "outputs": 2,
    "noerr": 0,
    "x": 470,
    "y": 620,
    "wires": [ [ "ui_c2_level", "ui_c2_chart" ], [ "ui_c2_pump" ] ]
  },
  {
    "id": "ui_grp_process2",
    "type": "ui_group",
    "name": "Process (TB2)",
    "tab": "ui_tab_cars",
    "order": 3,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_c2_level",
    "type": "ui_gauge",
    "name": "Tank2 level",
    "group": "ui_grp_process2",
    "order": 1,
    "width": "6",
    "height": "4",
    "gtype": "gage",
    "title": "TB2 Level",
    "label": "%",
    "format": "{{value | number:1}}",
    "min": "0",
    "max": "100",
    "colors": [ "#00b500", "#e6e600", "#ca3838" ],
    "seg1": "20",
    "seg2": "55",
    "x": 720,
    "y": 600,
    "wires": []
  },
  {
    "id": "ui_c2_chart",
    "type": "ui_chart",
    "name": "TB2 trend",
    "group": "ui_grp_process2",
    "order": 2,
    "width": "6",
    "height": "4",
    "label": "TB2 Level",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "ymin": "0",
    "ymax": "100",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "x": 720,
    "y": 640,
    "wires": [ [] ]
  },
  {
    "id": "ui_c2_pump",
    "type": "ui_text",
    "group": "ui_grp_process2",
    "order": 3,
    "width": "6",
    "height": "1",
    "name": "TB2 Pump",
    "label": "Pump (Q0.3)",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 720,
    "y": 680,
    "wires": []
  }
]
