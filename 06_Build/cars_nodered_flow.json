[
  {
    "id": "tab_cars_pipeline",
    "type": "tab",
    "label": "CARS Telemetry Pipeline",
    "disabled": false,
    "info": "Node-RED historian-collector (.2.30/sup0): S7 PLC1 + Modbus sim -> MQTT -> InfluxDB, with a /ui HMI.\nReads only (writes are CONTROL->FORBIDDEN + criticality-elevated in CARS). Scales to D2 by adding PLC2/tank2 topics."
  },
  {
    "id": "cfg_s7_plc1",
    "type": "s7 endpoint",
    "transport": "iso-on-tcp",
    "address": "192.168.2.10",
    "port": "102",
    "rack": "0",
    "slot": "1",
    "localtsaphi": "01",
    "localtsaplo": "00",
    "remotetsaphi": "01",
    "remotetsaplo": "02",
    "connmode": "rack-slot",
    "adapter": "",
    "busaddr": "2",
    "cycletime": "2000",
    "timeout": "2000",
    "name": "PLC1 S7 (.2.10)",
    "vartable": [
      { "addr": "DB7,REAL0", "name": "level" },
      { "addr": "Q0.0", "name": "pump" }
    ]
  },
  {
    "id": "cfg_mb_plc",
    "type": "modbus-client",
    "name": "Modbus sim (.2.20)",
    "clienttype": "tcp",
    "bufferCommands": true,
    "stateLogEnabled": false,
    "queueLogEnabled": false,
    "failureLogEnabled": true,
    "tcpHost": "192.168.2.20",
    "tcpPort": "502",
    "tcpType": "DEFAULT",
    "unit_id": "1",
    "commandDelay": "1",
    "clientTimeout": "2000",
    "reconnectOnTimeout": true,
    "reconnectTimeout": "2000",
    "parallelUnitIdsAllowed": true
  },
  {
    "id": "cfg_mqtt",
    "type": "mqtt-broker",
    "name": "Mosquitto (localhost)",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "cars-nodered",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "cfg_influx",
    "type": "influxdb",
    "hostname": "127.0.0.1",
    "port": "8086",
    "protocol": "http",
    "database": "cars",
    "name": "InfluxDB 2.x (cars)",
    "usetls": false,
    "influxdbVersion": "2.0",
    "url": "http://localhost:8086",
    "rejectUnauthorized": true
  },
  {
    "id": "ui_tab_cars",
    "type": "ui_tab",
    "name": "CARS Cell-1",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui_grp_process",
    "type": "ui_group",
    "name": "Process (TB1)",
    "tab": "ui_tab_cars",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_grp_modbus",
    "type": "ui_group",
    "name": "Modbus sim",
    "tab": "ui_tab_cars",
    "order": 2,
    "disp": true,
    "width": "6",
    "collapse": false
  },

  {
    "id": "s7_in_plc1",
    "type": "s7 in",
    "endpoint": "cfg_s7_plc1",
    "mode": "all",
    "variable": "",
    "diff": false,
    "name": "S7 read PLC1 (level+pump)",
    "x": 180,
    "y": 120,
    "wires": [ [ "fn_s7_pub", "fn_s7_ui" ] ]
  },
  {
    "id": "fn_s7_pub",
    "type": "function",
    "name": "-> MQTT topics",
    "func": "var p = msg.payload || {};\nvar out = [];\nif (p.level !== undefined) out.push({ topic: 'cars/cell1/plc1/level', payload: Number(p.level) });\nif (p.pump  !== undefined) out.push({ topic: 'cars/cell1/plc1/pump',  payload: p.pump ? 1 : 0 });\nreturn [ out ];",
    "outputs": 1,
    "noerr": 0,
    "x": 440,
    "y": 100,
    "wires": [ [ "mqtt_out" ] ]
  },
  {
    "id": "fn_s7_ui",
    "type": "function",
    "name": "level -> gauge/chart, pump -> text",
    "func": "var p = msg.payload || {};\nvar lvl = { payload: Number(p.level) };\nvar pmp = { payload: p.pump ? 'ON' : 'OFF' };\nreturn [ lvl, pmp ];",
    "outputs": 2,
    "noerr": 0,
    "x": 470,
    "y": 180,
    "wires": [ [ "ui_level", "ui_levelchart" ], [ "ui_pump" ] ]
  },

  {
    "id": "mb_read",
    "type": "modbus-read",
    "name": "Modbus read hr[0..9]",
    "topic": "",
    "showStatusActivities": false,
    "logIOActivities": false,
    "showErrors": true,
    "unitid": "1",
    "dataType": "HoldingRegister",
    "adr": "0",
    "quantity": "10",
    "rate": "2",
    "rateUnit": "s",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "cfg_mb_plc",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "x": 200,
    "y": 300,
    "wires": [ [ "fn_mb" ], [] ]
  },
  {
    "id": "fn_mb",
    "type": "function",
    "name": "-> MQTT + hr8",
    "func": "var regs = msg.payload;\nif (!Array.isArray(regs)) return null;\nvar out = [];\nout.push({ topic: 'cars/cell1/mb/hr', payload: JSON.stringify(regs) });\nout.push({ topic: 'cars/cell1/mb/hr8', payload: Number(regs[8]) });\nreturn [ out, { payload: Number(regs[8]) } ];",
    "outputs": 2,
    "noerr": 0,
    "x": 470,
    "y": 300,
    "wires": [ [ "mqtt_out" ], [ "ui_hr8" ] ]
  },

  {
    "id": "mqtt_out",
    "type": "mqtt out",
    "name": "publish cars/#",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "broker": "cfg_mqtt",
    "x": 760,
    "y": 160,
    "wires": []
  },

  {
    "id": "mqtt_in_hist",
    "type": "mqtt in",
    "name": "subscribe cars/cell1/#",
    "topic": "cars/cell1/#",
    "qos": "0",
    "datatype": "auto",
    "broker": "cfg_mqtt",
    "x": 190,
    "y": 460,
    "wires": [ [ "fn_to_influx" ] ]
  },
  {
    "id": "fn_to_influx",
    "type": "function",
    "name": "topic -> influx point",
    "func": "var t = msg.topic || '';\nvar parts = t.split('/');\nif (parts.length < 4) return null;\nvar cell = parts[1];\nvar field = parts.slice(2).join('_');\nvar val = Number(msg.payload);\nif (isNaN(val)) return null;\nmsg.payload = [ { [field]: val }, { cell: cell } ];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 440,
    "y": 460,
    "wires": [ [ "influx_out" ] ]
  },
  {
    "id": "influx_out",
    "type": "influxdb out",
    "influxdb": "cfg_influx",
    "name": "InfluxDB write (cars_telemetry)",
    "measurement": "cars_telemetry",
    "precision": "",
    "retentionPolicy": "",
    "database": "cars",
    "precisionV18FluxV20": "s",
    "retentionPolicyV18Flux": "",
    "org": "YOUR_ORG",
    "bucket": "cars",
    "x": 740,
    "y": 460,
    "wires": []
  },

  {
    "id": "ui_level",
    "type": "ui_gauge",
    "name": "Tank level",
    "group": "ui_grp_process",
    "order": 1,
    "width": "6",
    "height": "4",
    "gtype": "gage",
    "title": "TB1 Level",
    "label": "%",
    "format": "{{value | number:1}}",
    "min": "0",
    "max": "100",
    "colors": [ "#00b500", "#e6e600", "#ca3838" ],
    "seg1": "40",
    "seg2": "80",
    "x": 770,
    "y": 200,
    "wires": []
  },
  {
    "id": "ui_levelchart",
    "type": "ui_chart",
    "name": "Level trend",
    "group": "ui_grp_process",
    "order": 2,
    "width": "6",
    "height": "4",
    "label": "TB1 Level",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "ymin": "0",
    "ymax": "100",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "x": 780,
    "y": 240,
    "wires": [ [] ]
  },
  {
    "id": "ui_pump",
    "type": "ui_text",
    "group": "ui_grp_process",
    "order": 3,
    "width": "6",
    "height": "1",
    "name": "Pump",
    "label": "Pump / relay",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 760,
    "y": 280,
    "wires": []
  },
  {
    "id": "ui_hr8",
    "type": "ui_gauge",
    "name": "hr[8] safety reg",
    "group": "ui_grp_modbus",
    "order": 1,
    "width": "6",
    "height": "4",
    "gtype": "gage",
    "title": "Modbus hr[8]",
    "label": "value",
    "format": "{{value}}",
    "min": "0",
    "max": "5000",
    "colors": [ "#00b500", "#e6e600", "#ca3838" ],
    "seg1": "",
    "seg2": "",
    "x": 760,
    "y": 340,
    "wires": []
  }
]
