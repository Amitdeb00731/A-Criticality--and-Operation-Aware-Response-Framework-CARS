[Unit]
Description=CARS A1/P3 DEFLECT decoy (hpot .3.99 in hpotns netns on ovsgw)
After=openvswitch-switch.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# wait for ovsgw to exist in the OVS DB (~20s max) before configuring the decoy
ExecStartPre=/bin/bash -c 'for i in $(seq 1 20); do ovs-vsctl br-exists ovsgw && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/sbin/cars-hpot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
