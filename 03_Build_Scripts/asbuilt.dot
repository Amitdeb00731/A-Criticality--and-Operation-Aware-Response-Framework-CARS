digraph asbuilt {
  rankdir=TB; bgcolor="white"; fontname="Helvetica"; fontsize=14;
  labelloc="t"; label=<<b>CARS testbed — AS-BUILT (2026-07-07, dedicated controller)</b>>;
  node [fontname="Helvetica", fontsize=10, shape=box, style="filled", penwidth=1.1];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];

  hap [label="MikroTik hAP ac lite\nWIRED MGMT SWITCH (dumb L2)\nSDN control plane 10.10.10.0/24", shape=box, style="filled,rounded", fillcolor="#9C5700", fontcolor="white"];

  ctrl [label="Dell #2 — CARS CONTROLLER\nos-ken + cars_engine.py\n10.10.10.1 · OpenFlow :6653 · API :8080", shape=box, style="filled,rounded", fillcolor="#1F3864", fontcolor="white"];

  subgraph cluster_d1 {
    label="Dell #1 (pure OVS switch)"; style="rounded,filled"; fillcolor="#EDF1F8"; color="#2E5496"; fontsize=10;
    ovs1 [label="OVS br0 · dpid=1\nmgmt 10.10.10.2", fillcolor="#2E5496", fontcolor="white"];
  }
  subgraph cluster_d3 {
    label="Dell #3 (pure OVS switch)"; style="rounded,filled"; fillcolor="#EDF1F8"; color="#2E5496"; fontsize=10;
    ovs3 [label="OVS br0 · dpid=2\nmgmt 10.10.10.3", fillcolor="#2E5496", fontcolor="white"];
  }

  plc1 [label="PLC-1 (S7-1200)\n192.168.2.10\ne0:dc:a0:63:98:09", fillcolor="#FDE9D9", color="#9C5700", shape=box3d];
  hmi1 [label="HMI-1\n192.168.2.9\ne0:dc:a0:62:b7:4c", fillcolor="#E2EFDA", color="#1E7145"];
  plc2 [label="PLC-2 (S7-1200)\n192.168.2.10*\ne0:dc:a0:46:ff:ce", fillcolor="#FDE9D9", color="#9C5700", shape=box3d];
  hmi2 [label="HMI-2\n192.168.2.9*\ne0:dc:a0:5c:60:44", fillcolor="#E2EFDA", color="#1E7145"];

  // control plane (wired via hAP)
  ctrl -> hap [dir=none, color="#1F3864", penwidth=1.5, label="LAN4"];
  ovs1 -> hap [dir=none, color="#1F3864", style=dashed, label="LAN2\nOpenFlow→10.10.10.1:6653"];
  ovs3 -> hap [dir=none, color="#1F3864", style=dashed, label="LAN3\nOpenFlow→10.10.10.1:6653"];

  // data plane (USB-Eth)
  ovs1 -> plc1 [dir=both, label="USB-Eth enx…d874"];
  ovs1 -> hmi1 [dir=both, label="USB-Eth enx…aef0"];
  ovs3 -> plc2 [dir=both, label="USB-Eth enx…3f16"];
  ovs3 -> hmi2 [dir=both, label="USB-Eth enx…3cf9"];

  note [label="* Box2 = identical clone → same IPs, separate switch/segment (not interconnected).\nData plane 192.168.2.0/24 · Control 10.10.10.0/24 (wired hAP) · Internet 192.168.88.0/24 (WiFi).", shape=note, fillcolor="#FFF6D5", color="#9C5700", fontsize=8];
  { rank=same; ovs1; ctrl; ovs3; }
  { rank=same; plc1; hmi1; plc2; hmi2; }
}
